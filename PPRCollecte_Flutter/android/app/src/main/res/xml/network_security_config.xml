<?xml version="1.0" encoding="utf-8"?>
<!--
    Politique reseau du build RELEASE : HTTP cleartext INTERDIT, partout,
    sans exception. Seuls les certificats systeme sont acceptes.

    Le build DEBUG utilise une version permissive de ce meme fichier
    (src/debug/res/xml/network_security_config.xml) qui autorise le
    cleartext vers l'emulateur/localhost pour le developpement. Le
    resource merger Android substitue automatiquement la variante debug
    lors d'un build debug ; le release garde CE fichier strict.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        EXCEPTION TEMPORAIRE - A RETIRER QUAND LE SERVEUR PROD PASSE EN HTTPS.
        Le backend tourne actuellement sur http://81.192.142.205:6061 sans TLS,
        en attendant le deploiement du hardening serveur. Cette exception est
        host-by-host : la base-config reste strict pour tout le reste.
        Aligner avec CLEARTEXT_ALLOWED_HOSTS cote Dart (api_service.dart).
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">81.192.142.205</domain>
        <!-- IP LAN de dev (a editer selon le reseau, cf. [[project_demo_plan_b]]).
             Rebuild de l'APK requis apres modification (XML compile dans l'APK). -->
        <domain includeSubdomains="false">192.168.10.153</domain>
    </domain-config>
</network-security-config>
